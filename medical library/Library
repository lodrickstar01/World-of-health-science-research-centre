
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="A free university medical student library with notes, medical MCQs and revision resources.">
<title>MedLibrary | Free Medical Student Library</title>

<style>
:root {
  --green: #087f68;
  --dark: #173b33;
  --light: #f2f8f5;
  --muted: #63766e;
  --border: #dce8e2;
  --white: #ffffff;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="script.js"></script>
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--dark);
  background: #fff;
  line-height: 1.6;
}

button, input, select { font: inherit; }

a { color: var(--green); }

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 18px 7%;
  border-bottom: 1px solid var(--border);
  background: white;
  position: sticky;
  top: 0;
  z-index: 5;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  text-decoration: none;
  color: var(--dark);
}

.logo span { color: var(--green); }

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

nav a {
  text-decoration: none;
  color: var(--dark);
  font-size: 14px;
  font-weight: 700;
}

nav a:hover { color: var(--green); }

.hero {
  padding: 85px 7%;
  background: linear-gradient(120deg, #e6f6ee, #f7fbf9);
}

.eyebrow {
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h1 {
  font-size: clamp(36px, 6vw, 62px);
  line-height: 1.12;
  margin: 15px 0;
}

.hero p {
  max-width: 650px;
  color: var(--muted);
  font-size: 17px;
}

.btn {
  display: inline-block;
  border: none;
  border-radius: 8px;
  background: var(--green);
  color: white;
  padding: 12px 18px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
}

.btn:hover { background: #066653; }

.btn:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.section { padding: 45px 7%; }

.section h2 {
  margin: 0 0 5px;
  font-size: 28px;
}

.muted { color: var(--muted); }

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  padding: 25px 7%;
}

.stat {
  background: var(--light);
  border-radius: 12px;
  text-align: center;
  padding: 20px 10px;
}

.stat strong {
  display: block;
  color: var(--green);
  font-size: 25px;
}

.stat span {
  color: var(--muted);
  font-size: 13px;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin: 20px 0;
}

.chip {
  padding: 9px 14px;
  border: 1px solid var(--border);
  border-radius: 25px;
  background: white;
  color: var(--dark);
  cursor: pointer;
}

.chip.active, .chip:hover {
  background: var(--green);
  border-color: var(--green);
  color: white;
}

.search {
  width: 100%;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 9px;
  margin: 16px 0 5px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 18px;
  margin-top: 20px;
}

.card {
  border: 1px solid var(--border);
  padding: 20px;
  border-radius: 12px;
  background: white;
}

.card:hover {
  box-shadow: 0 5px 20px #173b3310;
}

.tag {
  color: var(--green);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .7px;
  font-weight: 800;
}

.card h3 { margin: 10px 0 5px; }

.card p {
  font-size: 14px;
  color: var(--muted);
}

.card a {
  display: inline-block;
  margin-top: 8px;
  font-weight: 700;
  text-decoration: none;
}

.panel {
  background: var(--light);
  border-radius: 14px;
  padding: 24px;
  margin-top: 20px;
}

.field {
  display: block;
  width: 100%;
  max-width: 420px;
  padding: 12px;
  margin: 10px 0 18px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: white;
}

.question {
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  margin: 17px 0;
}

.question h3 { font-size: 17px; }

.option {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 11px;
  margin: 8px 0;
  border: 1px solid var(--border);
  border-radius: 8px;
  cursor: pointer;
}

.option:hover { background: var(--light); }

.option input { margin-top: 5px; }

.option.correct {
  border-color: #16834b;
  background: #e8f8ed;
}

.option.wrong {
  border-color: #d14b4b;
  background: #fff0f0;
}

.feedback {
  background: var(--light);
  padding: 12px;
  border-radius: 8px;
  margin-top: 12px;
  font-size: 14px;
}

#quiz-result {
  font-size: 19px;
  font-weight: 800;
  margin: 18px 0;
}

.about { background: var(--light); }

.about p { max-width: 760px; }

footer {
  text-align: center;
  padding: 25px;
  font-size: 13px;
  color: var(--muted);
}

[hidden] { display: none !important; }

@media (max-width: 650px) {
  header {
    position: static;
    flex-direction: column;
    align-items: flex-start;
  }

  nav { gap: 12px; }

  .hero { padding: 55px 7%; }

  .stats { padding-top: 15px; }

  .stat strong { font-size: 20px; }

  .section { padding-top: 32px; padding-bottom: 32px; }
}
</style>
</head>

<body>

<header>
