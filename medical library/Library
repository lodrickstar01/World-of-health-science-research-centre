// ---------- STUDY RESOURCE SEARCH AND FILTERS ----------

const resourceSearch = document.getElementById("resource-search");
const resourceGrid = document.getElementById("resource-grid");
const resourceFilters = document.getElementById("resource-filters");
const resourceCount = document.getElementById("resource-count");

const resourceSubjects = [
  "All",
  ...new Set(resources.map(item => item.subject))
];

let selectedResourceSubject = "All";

resourceSubjects.forEach(subject => {
  const button = document.createElement("button");
  button.className = "chip";
  button.textContent = subject;
  button.type = "button";
  button.classList.toggle("active", subject === "All");

  button.addEventListener("click", () => {
    selectedResourceSubject = subject;

    resourceFilters.querySelectorAll("button").forEach(btn => {
      btn.classList.toggle("active", btn === button);
    });

    renderResources();
  });

  resourceFilters.appendChild(button);
});

function renderResources() {
  const term = resourceSearch.value.toLowerCase().trim();

  const filtered = resources.filter(item => {
    const subjectMatches =
      selectedResourceSubject === "All" ||
      item.subject === selectedResourceSubject;

    const textMatches =
      (item.title + " " + item.subject + " " + item.description)
        .toLowerCase().includes(term);

    return subjectMatches && textMatches;
  });

  resourceCount.textContent = filtered.length + " resource(s) found";
  resourceGrid.replaceChildren();

  if (filtered.length === 0) {
    resourceGrid.textContent = "No resources found. Try another search.";
    return;
  }

  filtered.forEach(item => {
    const card = document.createElement("article");
    card.className = "card";

    const tag = document.createElement("span");
    tag.className = "tag";
    tag.textContent = item.subject;

    const title = document.createElement("h3");
    title.textContent = item.title;

    const description = document.createElement("p");
    description.textContent = item.description;

    const link = document.createElement("a");
    link.href = item.file;
    link.textContent = "Open / Download PDF →";

    card.append(tag, title, description, link);
    resourceGrid.appendChild(card);
  });
}

resourceSearch.addEventListener("input", renderResources);
renderResources();

// ---------- MCQ QUIZ AND AUTOMATIC MARKING ----------

const subjectSelect = document.getElementById("mcq-subject");
const limitSelect = document.getElementById("question-limit");
const quizContainer = document.getElementById("quiz-container");
const submitButton = document.getElementById("submit-quiz");
const nextButton = document.getElementById("next-quiz");
const quizResult = document.getElementById("quiz-result");
const quizProgress = document.getElementById("quiz-progress");

let currentQuestions = [];
let submitted = false;

function shuffle(items) {
  const result = [...items];

  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }

  return result;
}

function loadQuiz() {
  submitted = false;
  quizResult.textContent = "";
  quizContainer.replaceChildren();

  submitButton.hidden = false;
  submitButton.disabled = false;
  nextButton.hidden = true;

  const subject = subjectSelect.value;

  const available = questions.filter(item =>
    subject === "All" || item.subject === subject
  );

  if (available.length === 0) {
    quizProgress.textContent = "No questions available for this subject yet.";
    submitButton.hidden = true;
    return;
  }

  const limit = limitSelect.value === "all"
    ? available.length
    : Number(limitSelect.value);

  currentQuestions = shuffle(available).slice(0, limit);

  quizProgress.textContent =
    currentQuestions.length + " questions in this quiz";

  currentQuestions.forEach((item, index) => {
    const card = document.createElement("article");
    card.className = "question";

    const heading = document.createElement("h3");
    heading.textContent = (index + 1) + ". " + item.q;

    const category = document.createElement("p");
    category.className = "tag";
    category.textContent = item.subject;

    card.append(category, heading);

    // Shuffle the answer positions without losing the correct answer.
    const shuffledOptions = shuffle(
      item.options.map((text, originalIndex) => ({
        text,
        originalIndex
      }))
    );

    shuffledOptions.forEach((option, optionIndex) => {
      const label = document.createElement("label");
      label.className = "option";

      const radio = document.createElement("input");
      radio.type = "radio";
      radio.name = "question-" + index;
      radio.value = String(option.originalIndex);

      const text = document.createElement("span");
      text.textContent =
        String.fromCharCode(65 + optionIndex) + ". " + option.text;

      label.append(radio, text);
      card.appendChild(label);
    });

    const feedback = document.createElement("div");
    feedback.className = "feedback";
    feedback.hidden = true;
    card.appendChild(feedback);

    quizContainer.appendChild(card);
  });
}

function submitQuiz() {
  if (submitted) return;

  const unanswered = currentQuestions.some((item, index) => {
    return !quizContainer.querySelector(
      'input[name="question-' + index + '"]:checked'
    );
  });

  if (unanswered) {
    quizResult.textContent =
      "Please answer every question before submitting.";
    return;
  }

  submitted = true;
  let score = 0;

  currentQuestions.forEach((item, index) => {
    const card = quizContainer.children[index];

    const selected = card.querySelector(
      'input[name="question-' + index + '"]:checked'
    );

    const selectedAnswer = Number(selected.value);
    const isCorrect = selectedAnswer === item.answer;

    if (isCorrect) score++;

    card.querySelectorAll(".option").forEach(label => {
      const radio = label.querySelector("input");
      const optionIndex = Number(radio.value);

      radio.disabled = true;

      if (optionIndex === item.answer) {
        label.classList.add("correct");
      }

      if (radio.checked && !isCorrect) {
        label.classList.add("wrong");
      }
    });

    const feedback = card.querySelector(".feedback");
    feedback.hidden = false;

    const title = document.createElement("strong");
    title.textContent = isCorrect
      ? "Correct answer!"
      : "Incorrect answer.";

    const explanation = document.createElement("p");
    explanation.textContent =
      "Correct answer: " + item.options[item.answer] +
      ". " + item.explanation;

    feedback.append(title, explanation);
  });

  const percentage = Math.round(
    (score / currentQuestions.length) * 100
  );

  quizResult.textContent =
    "Your score: " + score + "/" + currentQuestions.length +
    " (" + percentage + "%)";

  quizProgress.textContent =
    "Quiz completed. Review the explanations above.";

  submitButton.disabled = true;
  nextButton.hidden = false;
}

submitButton.addEventListener("click", submitQuiz);
nextButton.addEventListener("click", loadQuiz);
subjectSelect.addEventListener("change", loadQuiz);
limitSelect.addEventListener("change", loadQuiz);

document.getElementById("resource-total").textContent =
  resources.length;

document.getElementById("question-total").textContent =
  questions.length;

document.getElementById("year").textContent =
  new Date().getFullYear();

loadQuiz();
</script>
</body>
</html>
